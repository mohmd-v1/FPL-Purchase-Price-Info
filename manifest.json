{
  "manifest_version": 3,
  "name": "FPL Purchase Price Info",
  "version": "2.2",
  "description": "Displays purchase price, selling price, profit/loss, and predicted progress directly on player profiles using official FPL APIs.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://fantasy.premierleague.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.premierleague.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fantasy.premierleague.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "FPL Purchase Price Info"
  }
}
